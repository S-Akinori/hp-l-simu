---
import SectionTitle from "../SectionTitle.astro";
import { industries } from "../../data/lpContent";
---

<section id="industries" class="relative rounded-t-[32px] bg-white py-[58px] pb-[68px] max-sm:py-11 max-sm:pb-[52px]">
  <SectionTitle title="業界別シミュレーション例" />
  <div class="mx-auto grid w-[min(1080px,calc(100%_-_48px))] grid-cols-5 gap-5 max-[980px]:grid-cols-2 max-sm:w-[min(100%_-_28px,480px)] max-sm:grid-cols-1">
    {
      industries.map((item) => (
        <article class="motion-card animate-reveal-up overflow-hidden rounded-[9px] bg-white shadow-[0_12px_32px_rgba(24,86,44,0.12)]">
          <div class="h-[126px] bg-[linear-gradient(145deg,#e9f5ee,#f9fbfb)]"><img class="h-full w-full object-cover" src={item.image} alt="" loading="lazy" /></div>
          <h3 class="m-0 mb-3.5 px-3.5 pt-[17px] text-[13px] font-black">{item.title}</h3>
          <p class="m-0 px-3.5 pb-[18px] text-[11px] leading-[1.85] font-bold text-[#243129]">{item.text}</p>
        </article>
      ))
    }
  </div>
  <p class="mt-[26px] mb-0 text-center text-[11px] font-bold text-[#6c786f]">※上記は一例です。さまざまな業界・業種にご利用いただけます。</p>
</section>
