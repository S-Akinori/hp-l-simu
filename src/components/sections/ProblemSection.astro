---
import SectionTitle from "../SectionTitle.astro";
import { problems } from "../../data/lpContent";
---

<section class="relative bg-linear-to-b from-[#edf8ef] to-[#f7fcf7] py-[58px] pb-[68px] max-sm:py-11 max-sm:pb-[52px]">
  <SectionTitle title="こんなお悩みありませんか？" />
  <div class="mx-auto grid w-[min(1080px,calc(100%_-_48px))] grid-cols-4 gap-[54px] max-[980px]:grid-cols-2 max-sm:w-[min(100%_-_28px,480px)] max-sm:grid-cols-1 max-sm:gap-[30px]">
    {
      problems.map((item) => (
        <article class="motion-card animate-reveal-up rounded-xl p-2 text-center">
          <div class="mx-auto mb-5 grid h-[98px] w-[132px] place-items-center rounded-[50%] bg-white shadow-[0_14px_36px_rgba(24,86,44,0.06)]"><img class="h-[58px] w-[58px] object-contain" src={`/assets/${item.icon}`} alt="" /></div>
          <h3 class="m-0 mb-3.5 text-base font-black">{item.title}</h3>
          <p class="m-0 text-[13px] leading-[1.85] font-bold text-[#243129]">{item.text}</p>
        </article>
      ))
    }
  </div>
</section>
