---
import SectionTitle from "../SectionTitle.astro";
import { voices } from "../../data/lpContent";
---

<section id="voices" class="relative bg-linear-to-b from-[#f7fcf7] to-white py-[58px] pb-[68px] max-sm:py-11 max-sm:pb-[52px]">
  <SectionTitle title="お客様の声" />
  <!-- <button class="absolute top-[54%] left-[max(16px,calc((100%_-_1200px)/2))] grid h-[34px] w-[34px] place-items-center rounded-full border-0 bg-[#70bd72] text-[28px] leading-none text-white max-sm:hidden" aria-label="前へ">‹</button> -->
  <div class="mx-auto grid w-[min(1080px,calc(100%_-_48px))] grid-cols-3 gap-[34px] max-[980px]:grid-cols-2 max-sm:w-[min(100%_-_28px,480px)] max-sm:grid-cols-1">
    {
      voices.map((item) => (
        <article class="motion-card animate-reveal-up min-h-[178px] rounded-[11px] bg-white px-7 py-[25px] shadow-soft">
          <div class="mb-4 flex items-center gap-[13px]">
            <img class="h-[43px] w-[43px] rounded-full bg-[#edf8ef] object-contain" src={`/assets/${item.avatar}`} alt="" />
            <strong class="text-[13px] font-black">{item.name}</strong>
          </div>
          <p class="m-0 text-[13px] leading-[1.85] font-bold">{item.text}</p>
        </article>
      ))
    }
  </div>
  <!-- <button class="absolute top-[54%] right-[max(16px,calc((100%_-_1200px)/2))] grid h-[34px] w-[34px] place-items-center rounded-full border-0 bg-[#70bd72] text-[28px] leading-none text-white max-sm:hidden" aria-label="次へ">›</button> -->
</section>
