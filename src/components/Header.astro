---
import Button from "./Button.astro";
import { navItems } from "../data/lpContent";
import Logo from "@/images/logo.png";
import { Image } from "astro:assets";
import { siteConfig } from "../config/site";
---

<header class="sticky top-0 z-30 bg-white/90">
  <div class="mx-auto grid w-[min(1180px,calc(100%_-_48px))] grid-cols-[auto_1fr_auto] items-center gap-7 bg-white/90 pt-[22px] pb-3 backdrop-blur-[14px] max-[980px]:grid-cols-[1fr_auto] max-sm:w-[min(100%_-_28px,480px)] max-sm:pt-3.5">
      <a class="inline-flex items-start gap-2.5" href="/" aria-label="L-Simu トップ">
        <Image height={80} src={Logo} alt="L-Simu" />
      </a>
      <nav class="flex justify-end gap-[34px] text-[13px] font-extrabold max-[980px]:hidden">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    <div class="flex gap-3.5 max-sm:hidden">
      <Button href={siteConfig.materialsPath} download variant="outline" size="sm">資料ダウンロード</Button>
      <Button href="/contact/" variant="solid" size="sm">お問い合わせ</Button>
    </div>
  </div>
</header>
