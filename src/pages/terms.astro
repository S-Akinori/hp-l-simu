---
import PageHero from "../components/PageHero.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const termSections = [
  {
    title: "第1条 適用",
    paragraphs: [
      "本規約は、株式会社A-Key（以下「当社」といいます。）が提供するL-Simu（以下「本サービス」といいます。）の利用条件を定めるものです。",
      "利用者は、本規約に同意のうえ本サービスを利用するものとします。",
    ],
  },
  {
    title: "第2条 定義",
    paragraphs: [
      "「利用者」とは、本サービスの閲覧、問い合わせ、資料請求、導入相談、契約その他本サービスを利用する個人または法人をいいます。",
      "「コンテンツ」とは、本サービス上で提供される文章、画像、デザイン、プログラム、シミュレーションBot、その他一切の情報をいいます。",
    ],
  },
  {
    title: "第3条 利用申込み",
    paragraphs: [
      "本サービスの導入を希望する利用者は、当社所定の方法により申し込みを行うものとします。当社は、申込み内容を確認し、必要な手続きが完了した時点でサービス提供を開始します。",
      "当社は、申込み内容に虚偽がある場合、過去に本規約違反があった場合、その他当社が不適切と判断した場合、申込みを承諾しないことがあります。",
    ],
  },
  {
    title: "第4条 料金および支払方法",
    paragraphs: [
      "利用者は、本サービスの有料プランを利用する場合、当社が別途提示する料金および支払条件に従って利用料金を支払うものとします。",
      "利用者が支払期日までに料金を支払わない場合、当社は本サービスの提供を停止または契約を解除できるものとします。",
    ],
  },
  {
    title: "第5条 禁止事項",
    paragraphs: ["利用者は、本サービスの利用にあたり、以下の行為を行ってはなりません。"],
    list: [
      "法令または公序良俗に違反する行為",
      "当社または第三者の知的財産権、プライバシー権、信用その他の権利または利益を侵害する行為",
      "虚偽または不正確な情報を入力、送信、提供する行為",
      "本サービスの運営を妨害する行為",
      "本サービスを不正アクセス、解析、複製、改変、リバースエンジニアリングする行為",
      "反社会的勢力に対する利益供与その他これに準ずる行為",
      "その他、当社が不適切と判断する行為",
    ],
  },
  {
    title: "第6条 本サービスの停止等",
    paragraphs: [
      "当社は、システム保守、障害対応、天災地変、外部サービスの停止、その他やむを得ない事由がある場合、利用者へ事前に通知することなく本サービスの全部または一部を停止または中断できるものとします。",
    ],
  },
  {
    title: "第7条 知的財産権",
    paragraphs: [
      "本サービスおよび本サービスに関連するコンテンツの知的財産権は、当社または正当な権利を有する第三者に帰属します。",
      "利用者が本サービスの利用にあたり当社へ提供した情報、素材、データ等の権利は、利用者または正当な権利者に帰属します。ただし、当社は本サービスの提供、保守、改善に必要な範囲でこれらを利用できるものとします。",
    ],
  },
  {
    title: "第8条 保証の否認および免責",
    paragraphs: [
      "当社は、本サービスが利用者の特定の目的に適合すること、期待する成果を得られること、正確性、完全性、有用性、継続性について、明示または黙示を問わず保証しません。",
      "本サービスの利用に関連して利用者に損害が生じた場合であっても、当社の故意または重過失による場合を除き、当社は責任を負わないものとします。",
    ],
  },
  {
    title: "第9条 契約解除",
    paragraphs: [
      "利用者が本規約に違反した場合、料金の支払いを遅滞した場合、その他当社が本サービスの提供継続を不適切と判断した場合、当社は事前通知なく本サービスの利用停止または契約解除を行うことができます。",
    ],
  },
  {
    title: "第10条 個人情報の取り扱い",
    paragraphs: [
      "当社は、本サービスの利用により取得する個人情報を、当社が別途定めるプライバシーポリシーに従って適切に取り扱います。",
    ],
  },
  {
    title: "第11条 規約の変更",
    paragraphs: [
      "当社は、必要に応じて本規約を変更することがあります。変更後の規約は、当サイト上に掲載した時点から効力を生じるものとします。",
    ],
  },
  {
    title: "第12条 準拠法および管轄",
    paragraphs: [
      "本規約の解釈には日本法を準拠法とします。本サービスに関して紛争が生じた場合、東京地方裁判所を第一審の専属的合意管轄裁判所とします。",
    ],
  },
];
---

<SiteLayout title="利用規約 | L-Simu" description="L-Simuの利用条件、申込み、料金、禁止事項、サービス停止、知的財産権、免責、準拠法などを定めた利用規約です。">
  <main>
    <PageHero title="利用規約" lead="L-Simuをご利用いただく際の基本的な条件を掲載しています。" />
    <section class="bg-white py-[58px] pb-[68px]">
      <div class="mx-auto grid w-[min(860px,calc(100%_-_48px))] gap-6 text-[13px] leading-[1.9] font-bold text-[#39473d] max-sm:w-[min(100%_-_28px,480px)]">
        <div class="animate-reveal-up rounded-xl border border-[#dbeee0] bg-white p-7 shadow-soft">
          <p class="m-0 text-right text-xs font-black text-muted">制定日: 2026年6月8日</p>
          <p class="mt-4 mb-0">
            本規約は、L-Simuの利用条件を定めるものです。利用者は、本サービスを利用することにより、本規約に同意したものとみなされます。
          </p>
        </div>
        {
          termSections.map((section) => (
            <article class="animate-reveal-up rounded-xl border border-[#dbeee0] bg-white p-7 shadow-soft">
              <h2 class="m-0 mb-3 text-lg font-black text-ink">{section.title}</h2>
              <div class="grid gap-3">
                {section.paragraphs.map((paragraph) => <p class="m-0">{paragraph}</p>)}
                {section.list && (
                  <ul class="m-0 grid gap-2 pl-5">
                    {section.list.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</SiteLayout>
